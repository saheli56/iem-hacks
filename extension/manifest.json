{
  "manifest_version": 3,
  "name": "Trust Issue",
  "version": "1.0.0",
  "description": "AI-Powered Web Security Scanner by Trust Issue — trigger scans from any tab and watch them live",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trust Issue"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
